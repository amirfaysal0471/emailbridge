# ─────────────────────────────────────────────────────────────
# MailBridge — backend environment
# Copy to .env and fill in the values from Google Cloud Console.
# Never commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000

# Where the React app runs. Used for CORS and for the post-OAuth redirect.
FRONTEND_URL=http://localhost:5173

# ── Google OAuth 2.0 credentials ─────────────────────────────
# Google Cloud Console → APIs & Services → Credentials
# → Create credentials → OAuth client ID → Web application
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must match an "Authorized redirect URI" on the OAuth client, character for character.
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── Security ─────────────────────────────────────────────────
# Signs the httpOnly account cookie. At least 16 characters.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── Session storage ──────────────────────────────────────────
# Where the connected account lives between requests.
#   auto   → 'cookie' on serverless hosts (Vercel/Lambda), 'file' elsewhere
#   file   → JSON on disk; tokens never reach the browser (best locally)
#   cookie → the record AES-256-GCM encrypted into the httpOnly cookie
#            (required on serverless: read-only filesystem, no shared process)
SESSION_BACKEND=auto

# Used only by the file backend.
TOKEN_STORE_PATH=./data/accounts.json

# ── Deployment shape ─────────────────────────────────────────
# true  → the React app and this API are served from ONE origin (the Vercel
#         setup). No CORS, SameSite=Lax cookies, callback redirects to a path.
# false → split hosting. Requires CORS plus SameSite=None; Secure cookies,
#         which means HTTPS on both sides.
SAME_ORIGIN=false
